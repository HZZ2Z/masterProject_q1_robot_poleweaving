<mujoco model="g1_soccer">
  <include file="g1_13dof.xml" />
  <worldbody>
    <geom name="field_midline" type="box" pos="0 0 0.003" size="0.01 4.5 0.003" rgba="1 1 1 1" contype="0" conaffinity="0" />
    <!-- Goal boxes match resources/goal.urdf; they also collide with the ball. -->
    <geom name="goal_left_post" type="box" pos="7.3 1.35 0.5" size="0.3 0.05 0.5" rgba="1 1 1 1" />
    <geom name="goal_right_post" type="box" pos="7.3 -1.35 0.5" size="0.3 0.05 0.5" rgba="1 1 1 1" />
    <geom name="goal_back" type="box" pos="7.65 0 0.5" size="0.05 1.4 0.5" rgba="1 1 1 1" />
    <geom name="opponent_goal_left_post" type="box" pos="-7.3 1.35 0.5" size="0.3 0.05 0.5" rgba="1 1 1 1" />
    <geom name="opponent_goal_right_post" type="box" pos="-7.3 -1.35 0.5" size="0.3 0.05 0.5" rgba="1 1 1 1" />
    <geom name="opponent_goal_back" type="box" pos="-7.65 0 0.5" size="0.05 1.4 0.5" rgba="1 1 1 1" />
    <body name="ball" pos="1 0 0.1">
      <joint name="ball_free" type="free" />
      <geom name="soccer_ball" type="sphere" size="0.1" mass="0.43" rgba="1 1 1 1" friction="1 0.005 0.0038" />
    </body>
  </worldbody>
  <sensor>
    <framepos name="position" objtype="site" objname="policy_base" />
    <framequat name="orientation" objtype="site" objname="policy_base" />
    <velocimeter name="linear-velocity" site="policy_base" />
    <gyro name="angular-velocity" site="policy_base" />
    <framepos name="camera_position" objtype="site" objname="policy_camera" />
    <framequat name="camera_orientation" objtype="site" objname="policy_camera" />
  </sensor>
</mujoco>
